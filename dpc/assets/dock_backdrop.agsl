// Live RenderNode input. No page bitmap or screenshot is created by the app.
uniform shader scene;
uniform float4 bar;
uniform float4 lens;
uniform float density;
uniform float lift;
uniform float dark;
uniform float hazePass;
uniform float ultra;
uniform float3 glassTint;

float capsule(float2 p, float4 r) {
    float2 h = (r.zw-r.xy)*.5;
    float2 d = p-(r.xy+r.zw)*.5;
    d.x -= clamp(d.x, -max(h.x-h.y,0.0), max(h.x-h.y,0.0));
    return length(d)-h.y;
}
float2 normalAt(float2 p, float4 r) {
    float2 h = (r.zw-r.xy)*.5;
    float2 d = p-(r.xy+r.zw)*.5;
    d.x -= clamp(d.x, -max(h.x-h.y,0.0), max(h.x-h.y,0.0));
    return d/max(length(d),.001);
}
half4 at(float2 p) { return scene.eval(p); }

half4 glassAt(float2 p) {
    half4 original = at(p);
    float distance = capsule(p,bar);
    if (distance > 1.0) return original;
    float2 n = normalAt(p,bar);
    float halfMinor = (bar.w-bar.y)*.5;
    float bevel = min(20.0*density,halfMinor*.5);
    float rise = clamp(1.0+distance/max(bevel,1.0),0.0,1.0);
    float depth = min(60.0*density,halfMinor)*(1.0-sqrt(max(0.0,1.0-rise*rise)));
    float2 q = p-n*depth*ultra;
    // The two RenderEffect branches supply clear and genuinely Gaussian-blurred inputs.
    half4 sample = at(q);
    float luma = dot(float3(sample.rgb),float3(.2126,.7152,.0722));
    float3 rgb = mix(float3(luma),float3(sample.rgb),mix(2.1,1.925,dark));
    float3 tint = glassTint;
    float alpha = mix(.576,.48,dark);
    float contrast = mix((1.0-luma)*.4,luma*.4,dark);
    rgb = mix(rgb,tint,alpha+(1.0-alpha)*contrast);
    float rim = exp(-abs(distance+.8*density)/(1.3*density));
    float lit = max(0.0,-n.y)*.11 + max(0.0,n.y)*.04;
    rgb += rim*lit;
    return mix(original,half4(half3(clamp(rgb,0.0,1.0)),sample.a),
               half(1.0-smoothstep(-.7,1.0,distance)));
}
half4 main(float2 p) {
    // Most of the page is a single unchanged fetch, with no blur work.
    float bd = capsule(p,bar), ld = capsule(p,lens);
    if (bd>1.0 && (lift<.001 || ld>1.0)) return hazePass>.5?half4(0):at(p);
    half4 base = glassAt(p);
    if (ultra>.5 && lift>.001 && ld<=1.0) {
        float2 n = normalAt(p,lens);
        float inset = max(-ld,0.0), bevel = 5.5*density;
        float profile = smoothstep(0.0,bevel,inset)
            *(1.0-smoothstep(bevel,(lens.w-lens.y)*.5,inset));
        float2 q = p+n*(4.3*density*profile*lift);
        float edge = 1.0-smoothstep(1.0*density,8.0*density,inset);
        float2 split = n.yx*(3.25*density*edge*lift);
        half4 r = glassAt(q+split), g = glassAt(q), b = glassAt(q-split);
        float3 rgb = float3(r.r,g.g,b.b)*mix(1.0,1.33,dark);
        float rim = exp(-abs(ld+.65*density)/(1.1*density));
        rgb += rim*(max(-n.y,0.0)*.19+max(n.y,0.0)*.09);
        rgb -= rim*abs(n.x)*.045;
        half4 result = half4(half3(clamp(rgb,0.0,1.0)),g.a);
        base = mix(base,result,half(lift*(1.0-smoothstep(-.7,1.0,ld))));
    }
    if (hazePass>.5) {
        float cover = max(1.0-smoothstep(-.7,1.0,bd),lift*(1.0-smoothstep(-.7,1.0,ld)));
        base *= half(.72*cover);
    }
    return base;
}
